{
  // Cloudflare Worker config. The site itself is served as static assets from this
  // folder; the Worker in worker/index.js only handles /api/* requests.
  "name": "portfolio",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS"
  },
  // Sends email through Cloudflare Email Routing on manasbolt.com.
  // The destination must be a verified address in Email Routing.
  "send_email": [
    { "name": "NOTIFY", "destination_address": "manas.lfs@gmail.com" }
  ],
  // Caps notification requests per visitor so nobody can flood the inbox.
  "ratelimits": [
    { "name": "RL", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ],
  "vars": {
    "NOTIFY_TO": "manas.lfs@gmail.com",
    "NOTIFY_FROM": "notify@manasbolt.com",
    "SITE_HOSTS": "manasbolt.com,www.manasbolt.com"
  }
}
